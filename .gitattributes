# Line endings and binary files. Byte-exact content matters here: golden
# files, .jsonl fixtures, go.sum, fonts and the generated templates must
# check out the same everywhere (core.autocrlf and Windows included).

# Text files are LF in the index and in every checkout, matching
# .editorconfig (end_of_line = lf). Git detects binary files itself.
* text=auto eol=lf

# Images and fonts are binary: never converted, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.woff2 binary

# Vendored htmx: third-party minified code, left out of language statistics
# and review diffs on the forge.
internal/web/static/htmx.min.js linguist-vendored

# Generated by templ (make generate), committed and checked by
# make check-generated: collapsed in diffs, left out of language statistics.
internal/web/views_templ.go linguist-generated
