@@ -193,3 +207,43 @@ func printDoctor(w io.Writer, rs []doctor.Result) {
 func shellArgument(s string) string {
 	return "'" + strings.ReplaceAll(s, "'", "'\"'\"'") + "'"
 }
+
+// inspectAgentTopicPush is an explicit diagnostic until runtime configuration
+// exposes agent topic-push activation and its distinct identity. Its results
+// never enter admission or change the supervisor's policy.
+func inspectAgentTopicPush(ctx context.Context, path string, appID int64, skip bool) doctor.Result {
+	result := doctor.Result{Check: "agent-push-ruleset", Step: 2, Status: doctor.Warn}
+	if skip {
+		result.Status, result.Detail = doctor.Skipped, "skipped on request"
+		return result
+	}
+	cfg, err := config.Load(path)
+	if err != nil {
+		result.Status = doctor.NotVerified
+		result.Detail = "needs a valid configuration; diagnostic only: does not waive R-30 or authorize a run"
+		result.Fix = "whr setup"
+		return result
+	}
+	// The supervisor App only reads the evidence. Never substitute its App ID
+	// for the agent identity supplied by the operator.
+	var src doctor.AgentPushRuleSource
+	if gh, err := doctor.NewGitHub(cfg); err == nil {
+		src = gh
+	}
+	var details, fixes []string
+	for _, repo := range cfg.Repositories {
+		integration := repo.IntegrationBranch
+		if integration == "" && !repo.Preset().ToDefaultBranch() {
+			integration = repo.Target("")
+		}
+		evidence := doctor.InspectAgentPush(ctx, src, repo.Name, integration, appID)
+		if evidence.Status == doctor.NotVerified {
+			result.Status = doctor.NotVerified
+		}
+		details = append(details, repo.Name+": "+evidence.Detail)
+		fixes = append(fixes, evidence.Fix)
+	}
+	result.Detail = strings.Join(details, "; ")
+	result.Fix = strings.Join(fixes, " ")
+	return result
+}
