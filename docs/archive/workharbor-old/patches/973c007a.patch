+	"github.com/wstein/workharbor/internal/doctor"
+	"github.com/wstein/workharbor/internal/exitcode"
+)
+
+func TestDoctorAgentTopicPushDiagnostics(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name, status, detail                                  string
+		missing, bypass, incomplete, offline, unknownIdentity bool
+	}{
+		{name: "required policy", status: "warn", detail: "required pull request and approving review observed"},
+		{name: "missing policy", status: "warn", detail: "missing required pull request", missing: true},
+		{name: "agent bypass", status: "warn", detail: "agent App bypasses ruleset 4", bypass: true},
+		{name: "incomplete visibility", status: "not_verified", detail: "bypass actors unavailable", incomplete: true},
+		{name: "unknown agent identity", status: "not_verified", detail: "agent App identity unavailable", unknownIdentity: true},
+		{name: "forge unreachable", status: "not_verified", detail: "default branch unavailable", offline: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := newServiceRig(t)
+			var cfg config.Config
+			b, err := os.ReadFile(r.cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := json.Unmarshal(b, &cfg); err != nil {
+				t.Fatal(err)
+			}
+			cfg.Repositories[0].IntegrationBranch = "integration"
+			var branches []string
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				var body any
+				switch {
+				case req.URL.Path == "/repos/wstein/workharbor/installation":
+					body = map[string]any{"id": 5}
+				case req.URL.Path == "/app/installations/5/access_tokens":
+					body = map[string]any{"token": "fake-inspection-token", "expires_at": "2099-01-01T00:00:00Z"}
+				case tc.offline:
+					w.WriteHeader(http.StatusServiceUnavailable)
+					return
+				case req.URL.Path == "/repos/wstein/workharbor":
+					body = map[string]any{"default_branch": "main"}
+				case strings.Contains(req.URL.Path, "/rules/branches/"):
+					branches = append(branches, strings.TrimPrefix(req.URL.Path, "/repos/wstein/workharbor/rules/branches/"))
+					body = []any{}
+					if !tc.missing {
+						body = []any{map[string]any{"type": "pull_request", "ruleset_id": 4, "parameters": map[string]int{"required_approving_review_count": 1}}}
+					}
+				case req.URL.Path == "/repos/wstein/workharbor/rulesets/4":
+					body = map[string]any{}
+					if !tc.incomplete {
+						actors := []any{}
+						if tc.bypass {
+							actors = append(actors, map[string]any{"actor_id": 77, "actor_type": "Integration"})
+						}
+						body = map[string]any{"bypass_actors": actors}
+					}
+				default:
+					t.Errorf("unexpected request %s %s", req.Method, req.URL.Path)
+					w.WriteHeader(404)
+					return
+				}
+				if req.Method != http.MethodGet && req.URL.Path != "/app/installations/5/access_tokens" {
+					t.Errorf("forge mutation: %s %s", req.Method, req.URL.Path)
+				}
+				_ = json.NewEncoder(w).Encode(body)
+			}))
+			defer server.Close()
+			cfg.GitHub.APIURL = server.URL
+			if err := os.WriteFile(cfg.GitHub.KeyFile, pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)}), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			b, err = json.Marshal(cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(r.cfg, b, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			setup := newSetupRig(t)
+			var out, errOut bytes.Buffer
+			env := Env{Stdout: &out, Stderr: &errOut, Getenv: func(string) string { return "" }, Setup: setup.env}
+			args := []string{"doctor", "--config", r.cfg, "--json", "--agent-topic-push"}
+			if !tc.unknownIdentity {
+				args = append(args, "--agent-app-id", "77")
+			}
+			for _, check := range doctor.Checks(doctor.Deps{}) {
+				if !check.SetupOnly {
+					args = append(args, "--skip", check.Name)
+				}
+			}
+			code := Execute(context.Background(), env, args)
+			if code != exitcode.OK {
+				t.Fatalf("exit %d: %s", code, errOut.String())
+			}
+			var report struct{ Checks []doctor.Result }
+			if err := json.Unmarshal(out.Bytes(), &report); err != nil {
+				t.Fatal(err)
+			}
+			var found bool
+			for _, result := range report.Checks {
+				if result.Check == "agent-push-ruleset" {
+					found = true
+					if string(result.Status) != tc.status || !strings.Contains(result.Detail, tc.detail) || result.Fix != "https://github.com/wstein/workharbor/settings/rules" {
+						t.Errorf("diagnostic: %+v", result)
+					}
+					for _, boundary := range []string{"tag restrictions not_verified", "release/deployment denial not_verified", "does not waive R-30 or authorize a run"} {
+						if !strings.Contains(result.Detail, boundary) {
+							t.Errorf("missing %s", boundary)
+						}
+					}
+				}
+			}
+			if !found {
+				t.Fatalf("missing agent-push-ruleset: %s", out.String())
+			}
+			if !tc.offline && strings.Join(branches, ",") != "main,integration" {
+				t.Errorf("branches = %v", branches)
+			}
+			if len(setup.host.ran) != 0 || len(setup.host.opened) != 0 || setup.host.asked != 0 {
+				t.Fatal("doctor changed host or requested approval")
+			}
+		})
+	}
+}
+
+func TestDoctorAgentTopicPushFlagsAndSkip(t *testing.T) {
+	for _, args := range [][]string{
+		{"doctor", "--agent-app-id", "77"},
+		{"doctor", "--agent-topic-push", "--agent-app-id", "-1"},
+		{"doctor", "--skip", "agent-push-ruleset"},
+	} {
+		r := newSetupRig(t)
+		if code, _, _ := r.run(args...); code != exitcode.Usage {
+			t.Errorf("%v: exit %d", args, code)
+		}
+	}
+	r := newSetupRig(t)
+	args := []string{"doctor", "--agent-topic-push", "--skip", "agent-push-ruleset", "--json"}
+	for _, check := range doctor.Checks(doctor.Deps{}) {
+		if !check.SetupOnly {
+			args = append(args, "--skip", check.Name)
+		}
+	}
+	code, out, errOut := r.run(args...)
+	if code != exitcode.OK {
+		t.Fatalf("skip: exit %d: %s", code, errOut)
+	}
+	var report struct{ Checks []doctor.Result }
+	if err := json.Unmarshal([]byte(out), &report); err != nil {
+		t.Fatal(err)
+	}
+	for _, result := range report.Checks {
+		if result.Check == "agent-push-ruleset" {
+			if result.Status != doctor.Skipped || result.Fix != "" {
+				t.Fatalf("skip result %+v", result)
+			}
+			return
+		}
+	}
+	t.Fatal("missing skipped diagnostic")
+}
