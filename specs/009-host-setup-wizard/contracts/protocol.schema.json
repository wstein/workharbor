{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workharbor.invalid/specs/009-host-setup-wizard/contracts/protocol.schema.json",
  "title": "Run protocol record, one JSON object per line (proposed)",
  "description": "Append-only `<state>/protocols/<run-id>.jsonl` for a real run of `whr setup` or `whr doctor --fix`; `<run-id>.txt` renders it (FR-019). Mode 0600 in a 0700 directory. No password, token, git value or environment content. Not written for `no`, --dry-run or plain doctor.",
  "type": "object",
  "required": ["type", "run_id", "time"],
  "properties": {
    "type": {"enum": ["run_start", "selection", "step", "backup", "diff", "run_end"]},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "time": {"type": "string", "format": "date-time"},
    "command": {"enum": ["setup", "doctor_fix"]},
    "platform": {"type": "string"},
    "catalogue_version": {"type": "string"},
    "answer": {"enum": ["yes", "customize", "flags"]},
    "selected": {"type": "array", "items": {"type": "string"}},
    "opted_out": {"type": "array", "items": {"type": "string"}},
    "step_id": {"type": "string"},
    "kind": {"type": "string"},
    "item": {"type": "string"},
    "argv": {"type": "array", "items": {"type": "string"}},
    "sudo": {"type": "boolean"},
    "network": {"type": "boolean"},
    "exit_status": {"type": ["integer", "null"]},
    "result": {"type": "string"},
    "path": {"type": "string", "description": "~-relative"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "added_lines": {"type": "integer"},
    "removed_lines": {"type": "integer"},
    "exit_code": {"type": "integer"},
    "applied": {"type": "array", "items": {"type": "string"}},
    "remaining": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
