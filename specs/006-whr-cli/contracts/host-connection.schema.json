{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workharbor:host-connection:1",
  "description": "Draft version1; strict decoding, raw/canonical4KiB and trusted peer scope are additional required boundaries.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "owner_id",
        "host_id",
        "capabilities"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "kind": {
          "const": "hello"
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "host_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "capabilities": {
          "enum": [
            [],
            [
              "docker"
            ]
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "owner_id",
        "host_id"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "hello_ack",
            "heartbeat",
            "heartbeat_ack"
          ]
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "host_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    }
  ]
}
