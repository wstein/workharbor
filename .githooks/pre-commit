#!/bin/sh
# Scan the staged change for secrets, then enforce formatting and linting,
# before each commit. Enable with `make hooks`.
set -e
# MAKEFLAGS, MAKEFILES and friends can turn a recipe off (GITLEAKS_FOUND=0,
# -n, -i, a replaced SHELL).
unset MAKEFLAGS MFLAGS GNUMAKEFLAGS MAKELEVEL MAKEFILES
make secrets-staged fmt-check lint editorconfig
