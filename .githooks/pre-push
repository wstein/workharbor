#!/bin/sh
# Scan every commit about to be pushed for secrets, before it leaves the
# machine. Enable with `make hooks`. Git passes one line per ref on stdin:
# <local ref> <local sha> <remote ref> <remote sha>.
set -e
# MAKEFLAGS, MAKEFILES and friends can turn a recipe off (GITLEAKS_FOUND=0,
# -n, -i, a replaced SHELL).
unset MAKEFLAGS MFLAGS GNUMAKEFLAGS MAKELEVEL MAKEFILES
zero=0000000000000000000000000000000000000000
# `command make` skips an exported shell function named make (bash imports one
# from BASH_FUNC_make%% even as sh); it is a speed bump, not a wall. Exported
# shell functions are out of scope as a class (BASH_FUNC_command%% or
# BASH_FUNC_read%% replace `command` and `read` themselves, and sh cannot close
# that), like a make earlier on PATH and --no-verify: the hooks guard the
# pusher's own machine against accidents, and CI scans too (#190).
while read -r ref local_sha _ remote_sha || [ -n "$ref" ]; do # a last line with no newline still counts
  case "$local_sha:$remote_sha" in
    "":* | *:"")
      echo "the secret scan could not run (git sent a malformed ref line), so nothing was checked and the push is blocked" >&2
      exit 1
      ;;
  esac
  [ "$local_sha" = "$zero" ] && continue # a branch being deleted carries no commit
  # A ref to a blob or a tree holds no commit for gitleaks to read, so it would
  # pass unscanned: block it. An annotated tag peels to its commit.
  if ! git cat-file -e "$local_sha^{commit}" 2>/dev/null; then
    echo "the secret scan could not run ($local_sha is not a commit: a ref to a blob or a tree), so nothing was checked and the push is blocked" >&2
    exit 1
  fi
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # a new branch: what no remote has yet
  elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    # The remote moved on and this clone never fetched its tip (a force push):
    # gitleaks reads an unresolvable range as clean, so scan what no remote ref
    # has instead: every commit reachable from the pushed tip that no
    # remote-tracking ref holds (one that another remote's ref already holds
    # is left out). Blocking here would stop a legitimate force push for no
    # gain; a new branch and a delete are handled above and never reach this.
    range="$local_sha --not --remotes"
  fi
  # The recipe says which it is: a finding (gitleaks exit 42) or a scan that
  # could not run (a missing go, a failed install, any other exit). Both block
  # the push. TIP lets it read an annotated tag's own message too.
  command make -s secrets-range RANGE="$range" TIP="$local_sha" >&2 || exit 1
done
