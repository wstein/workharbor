#!/bin/sh
# Scan every commit about to be pushed for secrets, before it leaves the
# machine. Enable with `make hooks`. Git passes one line per ref on stdin:
# <local ref> <local sha> <remote ref> <remote sha>.
set -e
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a branch being deleted carries no commit
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # a new branch: what no remote has yet
  else
    range="$remote_sha..$local_sha"
  fi
  # The recipe says which it is: a finding (gitleaks exit 1) or a scan that
  # could not run (a missing go, any other exit). Both block the push.
  make -s secrets-range RANGE="$range" >&2 || exit 1
done
