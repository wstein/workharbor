root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

# templ's own formatter indents with tabs.
[*.templ]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[LICENSE]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[spikes/**/results/**]
indent_style = unset
indent_size = unset
