package web

import "strconv"

// Every string below is text, escaped by templ. No template uses templ.Raw or an
// unsafe attribute: text from an issue, an agent or the forge never becomes HTML.

templ layout(n nav, title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true}'/>
			<title>{ title } · workharbor</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="icon" type="image/svg+xml" href="/static/icons/favicon.svg"/>
			<link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png"/>
			<meta name="theme-color" content="#0c1b33"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="workharbor"/>
			<script src="/static/pwa.js" defer></script>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
			<script src="/static/sse.js" defer></script>
			<script src="/static/passkey.js" defer></script>
			if n.CSRF != "" {
				<meta name="csrf-token" content={ n.CSRF }/>
			}
		</head>
		<body hx-boost="true">
			<header class="bar">
				<a class="brand" href="/">workharbor</a>
				if n.CSRF != "" {
					<nav>
						<a href="/" class={ tab(n.Active, "harbor") }>Harbor</a>
						<a href="/inbox" class={ tab(n.Active, "inbox") }>
							Inbox
							if n.Inbox > 0 {
								<span class="count">{ strconv.Itoa(n.Inbox) }</span>
							}
						</a>
						<a href="/changes" class={ tab(n.Active, "changes") }>Changes</a>
						<a href="/devices" class={ tab(n.Active, "devices") }>Devices</a>
					</nav>
					<form method="post" action="/logout" hx-boost="false">
						<input type="hidden" name="csrf" value={ n.CSRF }/>
						<button class="quiet">Sign out</button>
					</form>
				}
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

func tab(active, name string) string {
	if active == name {
		return "tab current"
	}
	return "tab"
}

templ flashNote(msg string) {
	if msg != "" {
		<p class="flash" role="status">{ msg }</p>
	}
}

templ loginView(msg string, passkeys bool) {
	@layout(nav{}, "Sign in") {
		<h1>Sign in</h1>
		if msg != "" {
			<p class="flash bad" role="alert">{ msg }</p>
		}
		if passkeys {
			<p>Sign in with the passkey on this device. It asks for your face, fingerprint or PIN.</p>
			<p><button class="primary" type="button" data-passkey="login">Sign in with a passkey</button></p>
			<p class="flash bad" role="alert" data-passkey-status hidden></p>
			<noscript><p class="muted">Signing in with a passkey needs JavaScript.</p></noscript>
		} else {
			<form method="post" action="/login" hx-boost="false" class="stack">
				<label for="token">API token</label>
				<input id="token" name="token" type="password" autocomplete="current-password" required/>
				<button class="primary">Sign in</button>
			</form>
			<p class="muted">The token is the one in your `whr` configuration (<code>api_token_file</code>). Once you enrol a passkey from the host (<code>whr passkey add</code>), the token no longer signs in here.</p>
		}
	}
}

templ enrolView(token string) {
	@layout(nav{}, "Enrol a passkey") {
		<h1>Enrol a passkey</h1>
		if token == "" {
			<p class="flash bad" role="alert">This enrolment link is not valid, has expired or was already used. Run <code>whr passkey add</code> on the host to get a new one.</p>
		} else {
			<p>This registers the passkey of this device for signing in and for approving a push. It asks for your face, fingerprint or PIN. Only its public key is kept here.</p>
			<p><button class="primary" type="button" data-passkey="enrol" data-token={ token }>Create the passkey</button></p>
			<p class="flash" role="status" data-passkey-status hidden></p>
			<noscript><p class="muted">Enrolling a passkey needs JavaScript.</p></noscript>
		}
	}
}

templ errorPage(csrf string, status int, msg string) {
	@layout(nav{CSRF: csrf}, "Error") {
		<h1>{ strconv.Itoa(status) }</h1>
		<p class="flash bad" role="alert">{ msg }</p>
		<p><a href="/">Back to the harbor</a></p>
	}
}

templ taskList(rows []taskRow) {
	<ul class="cards">
		for _, t := range rows {
			<li class="card">
				<a href={ templ.SafeURL("/tasks/" + t.ID) }>
					<strong>{ t.Repo }{ t.Issue }</strong>
					<span class={ "state " + t.State }>{ t.State }</span>
				</a>
				if t.Agent != "" {
					<span class="muted">{ t.Agent }</span>
				}
			</li>
		}
	</ul>
}

templ harborView(p harborPage) {
	@layout(p.nav, "Harbor") {
		<h1>Harbor</h1>
		@flashNote(p.Flash)
		<section aria-labelledby="needs">
			<h2 id="needs">Needs you</h2>
			if len(p.NeedsYou) == 0 {
				<p class="muted">Nothing is waiting for you.</p>
			} else {
				@taskList(p.NeedsYou)
			}
		</section>
		<section aria-labelledby="start">
			<h2 id="start">Start a task</h2>
			if len(p.Agents) == 0 {
				<p class="muted">No agent exists yet: create one with <code>whr ws add</code>.</p>
			} else {
				<form method="post" action="/tasks" class="stack">
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					<input type="hidden" name="key" value={ p.Key }/>
					<label for="issue">Issue address</label>
					<input id="issue" name="issue" type="url" inputmode="url" placeholder="https://github.com/owner/repo/issues/12" required/>
					<label for="agent">Agent</label>
					<select id="agent" name="agent" required>
						for _, a := range p.Agents {
							<option value={ a.Ref }>{ a.Ref } ({ a.Repo })</option>
						}
					</select>
					<button class="primary">Start</button>
				</form>
			}
		</section>
		<section aria-labelledby="others">
			<h2 id="others">Tasks</h2>
			if len(p.Others) == 0 {
				<p class="muted">No other tasks.</p>
			} else {
				@taskList(p.Others)
			}
		</section>
	}
}

templ decisionCard(d decisionRow, csrf string, stepUp bool) {
	<article class="decision">
		<h3>{ d.Kind }</h3>
		<p class="subject">{ d.Subject }</p>
		if d.Input != "" {
			<pre class="untrusted">{ d.Input }</pre>
		}
		if d.Deadline != "" {
			<p class="muted">Answer by { d.Deadline } or it is denied.</p>
		}
		<p class="muted"><a href={ templ.SafeURL("/tasks/" + d.TaskID) }>Open the task</a></p>
		if d.Review && stepUp {
			<p class="flash">This answer needs your passkey: it is for exactly { d.For }.</p>
			<label for={ "reason-" + d.ID }>Reason (optional, the agent sees it)</label>
			<input id={ "reason-" + d.ID } name="reason" type="text" maxlength="500"/>
			<div class="actions">
				for _, o := range d.Options {
					<button type="button" data-stepup={ o } data-decision={ d.ID } data-reason={ "reason-" + d.ID } class={ optionClass(o) }>{ o } with passkey</button>
				}
			</div>
			<p class="flash bad" role="alert" data-passkey-status hidden></p>
			<noscript><p class="muted">Answering with a passkey needs JavaScript.</p></noscript>
		} else if d.Review {
			<p class="flash">This answer needs your passkey, and none is enrolled. Enrol one from the host (<code>whr passkey add</code>), or answer it with <code>whr approve</code> or <code>whr reject</code> on the host.</p>
		} else {
			<form method="post" action={ templ.SafeURL("/decisions/" + d.ID + "/answer") } class="stack">
				<input type="hidden" name="csrf" value={ csrf }/>
				<input type="hidden" name="key" value={ d.Key }/>
				<label for={ "reason-" + d.ID }>Reason (optional, the agent sees it)</label>
				<input id={ "reason-" + d.ID } name="reason" type="text" maxlength="500"/>
				<div class="actions">
					for _, o := range d.Options {
						<button name="option" value={ o } class={ optionClass(o) }>{ o }</button>
					}
				</div>
			</form>
		}
	</article>
}

func optionClass(o string) string {
	switch o {
	case "allow", "start", "resume":
		return "primary"
	case "deny", "cancel":
		return "danger"
	}
	return ""
}

templ inboxView(p inboxPage) {
	@layout(p.nav, "Inbox") {
		<h1>Inbox</h1>
		@flashNote(p.Flash)
		if len(p.Decisions) == 0 {
			<p class="muted">Nothing needs an answer.</p>
		}
		for _, d := range p.Decisions {
			@decisionCard(d, p.CSRF, p.StepUp)
		}
		if len(p.Previews) > 0 {
			<section aria-labelledby="previews-h">
				<h2 id="previews-h">Open previews</h2>
				<ul class="rows">
					for _, v := range p.Previews {
						<li>
							<a href={ templ.SafeURL("/tasks/" + v.TaskID) }>{ v.TaskID }</a>
							<span class="muted">port { strconv.Itoa(v.Port) }</span>
							@previewButtons(v, p.CSRF)
						</li>
					}
				</ul>
			</section>
		}
	}
}

// previewButtons opens an open preview in a new tab (a link, because the preview
// has an origin of its own) and closes it.
templ previewButtons(v previewRow, csrf string) {
	<a class="button" href={ templ.SafeURL("/previews/" + v.ID + "/go") } target="_blank" rel="noopener noreferrer" hx-boost="false">Open preview</a>
	<form method="post" action={ templ.SafeURL("/previews/" + v.ID + "/close") } hx-boost="false">
		<input type="hidden" name="csrf" value={ csrf }/>
		<button class="quiet">Close</button>
	</form>
}

templ eventItem(e eventRow) {
	<li class={ "ev " + e.Label } id={ evID(e) }>
		<span class="at">{ e.At }</span>
		<span class="label">{ e.Label }</span>
		if e.Text != "" {
			<span class="text">{ e.Text }</span>
		}
		if e.Detail != "" {
			<pre class="untrusted">{ e.Detail }</pre>
		}
	</li>
}

func evID(e eventRow) string {
	if e.Seq == 0 {
		return ""
	}
	return "ev-" + itoa(e.Seq)
}

templ taskView(p taskPage) {
	@layout(p.nav, p.Repo+p.Issue) {
		<h1>{ p.Repo }{ p.Issue }</h1>
		@flashNote(p.Flash)
		<p>
			<span class={ "state " + p.State }>{ p.State }</span>
			if p.Agent != "" {
				<span class="muted">{ p.Agent }</span>
			}
			if p.Branch != "" {
				<span class="muted">{ p.Branch }</span>
			}
			if p.PRURL != "" {
				<a href={ templ.SafeURL(p.PRURL) } rel="noreferrer">pull request</a>
			}
		</p>
		if len(p.Decisions) > 0 {
			<section aria-labelledby="open">
				<h2 id="open">Waiting for you</h2>
				for _, d := range p.Decisions {
					@decisionCard(d, p.CSRF, p.StepUp)
				}
			</section>
		}
		if p.PreviewsOn && len(p.Previews) > 0 {
			<section aria-labelledby="previews-h">
				<h2 id="previews-h">Previews</h2>
				<p class="muted">A web app the agent runs, shown through workharbor on a port and an origin of its own. It is code the agent wrote: it cannot see this page, and its link works once.</p>
				<ul class="rows">
					for _, v := range p.Previews {
						<li>
							<strong>port { strconv.Itoa(v.Port) }</strong>
							if v.ID != "" {
								@previewButtons(v, p.CSRF)
							} else {
								<form method="post" action={ templ.SafeURL("/tasks/" + p.ID + "/previews") } hx-boost="false">
									<input type="hidden" name="csrf" value={ p.CSRF }/>
									<input type="hidden" name="key" value={ v.Key }/>
									<input type="hidden" name="port" value={ strconv.Itoa(v.Port) }/>
									<button>Start a preview</button>
								</form>
							}
						</li>
					}
				</ul>
			</section>
		}
		<section aria-labelledby="transcript-h">
			<h2 id="transcript-h">Transcript</h2>
			if p.Earlier > 0 {
				<p class="muted">{ strconv.Itoa(p.Earlier) } earlier events are not shown: <code>whr logs</code> has them.</p>
			}
			<ol id="transcript" class="transcript" data-live="true" hx-ext="sse" sse-connect={ p.sinceURL() } sse-swap="ev" hx-swap="beforeend">
				for _, e := range p.Events {
					@eventItem(e)
				}
			</ol>
			<noscript><p class="muted">This is the transcript as of loading the page; reload it to see more.</p></noscript>
		</section>
		<section aria-labelledby="say">
			<h2 id="say">Send a message</h2>
			<form method="post" action={ templ.SafeURL("/tasks/" + p.ID + "/say") } class="stack">
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				<input type="hidden" name="key" value={ p.SayKey }/>
				<label for="message">To the agent</label>
				<textarea id="message" name="message" rows="3" maxlength="20000" required></textarea>
				<button class="primary">Send</button>
			</form>
		</section>
		if p.Agent != "" {
			<form method="post" action={ templ.SafeURL("/tasks/" + p.ID + "/open") } class="actions">
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				<button>Make an editor copy</button>
			</form>
		}
		if p.CanPause || p.CanResume {
			<form method="post" action={ templ.SafeURL("/tasks/" + p.ID + runVerb(p)) } class="actions">
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				<input type="hidden" name="key" value={ p.ActKey }/>
				if p.CanPause {
					<button>Pause the run</button>
					<span class="muted">Stops the agent now (it cannot pause politely); the environment keeps running and its open questions are asked again after a resume.</span>
				} else {
					<button class="primary">Resume the run</button>
				}
			</form>
		}
		<p><a class="button" href={ templ.SafeURL("/tasks/" + p.ID + "/purge") }>Delete the transcript…</a></p>
		if p.Cancelable {
			<p><a class="button danger" href={ templ.SafeURL("/tasks/" + p.ID + "/cancel") }>Cancel this task…</a></p>
		}
	}
}

templ purgeView(p purgePage) {
	@layout(p.nav, "Delete the transcript") {
		<h1>Delete the transcript of { p.Repo }{ p.Issue }?</h1>
		<p>This deletes { strconv.Itoa(p.Events) } transcript event(s), { strconv.FormatInt(p.Bytes, 10) } byte(s): what the agent said, its tool inputs and results and its diffs. It cannot be undone.</p>
		<p>The audit entries, the usage records and the Decisions stay, and so does the agent's own session. The purge is recorded as an audit entry. It is refused while the run is running: pause it first.</p>
		<form method="post" action={ templ.SafeURL("/tasks/" + p.ID + "/purge") } class="actions">
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="key" value={ p.Key }/>
			<button class="danger">Delete the transcript</button>
			<a class="button" href={ templ.SafeURL("/tasks/" + p.ID) }>Keep it</a>
		</form>
	}
}

templ changesView(p changesPage) {
	@layout(p.nav, "Changes") {
		<h1>Changes to confirm</h1>
		@flashNote(p.Flash)
		<p class="muted">A change of the rules, or of a secret, is never done by a signed-in session alone: it needs your passkey, and the passkey names the change. The host's command line stays the other way.</p>
		<section aria-labelledby="workflows">
			<h2 id="workflows">Workflow of a repository</h2>
			if len(p.Changes) == 0 {
				<p class="muted">Nothing waits. A repository's preset or integration branch is changed in the configuration; the change shows here after <code>whr serve</code> starts with it.</p>
			}
			for _, c := range p.Changes {
				<article class="decision">
					<h3>{ c.Repo }</h3>
					<p class="subject">{ c.From } becomes { c.To }</p>
					<p class="muted">Until you confirm, the repository stays as it is, and a confirmed change takes effect when <code>whr serve</code> is restarted.</p>
					if p.StepUp {
						<div class="actions">
							<button type="button" data-stepup="confirm" data-url={ "/changes/" + c.ID + "/stepup" } class="primary">Confirm with passkey</button>
						</div>
						<p class="flash bad" role="alert" data-passkey-status hidden></p>
						<noscript><p class="muted">Confirming with a passkey needs JavaScript.</p></noscript>
					} else {
						<p class="flash">This needs your passkey, and none is enrolled. Enrol one from the host (<code>whr passkey add</code>), or start <code>whr serve</code> with <code>--accept-workflow-change</code>.</p>
					}
				</article>
			}
		</section>
		if p.Revoke {
			<section aria-labelledby="secrets">
				<h2 id="secrets">Secrets</h2>
				<article class="decision">
					<h3>Revoke the forge tokens</h3>
					<p class="subject">Every installation token the supervisor holds is revoked now. Nothing is stopped; a new token is made when one is needed. No secret is shown here.</p>
					if p.StepUp {
						<div class="actions">
							<button type="button" data-stepup="revoke" data-url="/secrets/revoke-tokens/stepup" class="danger">Revoke with passkey</button>
						</div>
						<p class="flash bad" role="alert" data-passkey-status hidden></p>
						<noscript><p class="muted">Revoking with a passkey needs JavaScript.</p></noscript>
					} else {
						<p class="flash">This needs your passkey, and none is enrolled. Use <code>whr kill-all</code> on the host.</p>
					}
				</article>
			</section>
		}
	}
}

templ devicesView(p devicesPage) {
	@layout(p.nav, "Devices") {
		<h1>Signed-in devices</h1>
		@flashNote(p.Flash)
		<p class="muted">Each browser that signed in has its own session. A phone signs itself out after 15 minutes without use. Sign out a lost device here, from another one.</p>
		if !p.Revocable {
			<p class="flash">This sign-in does not keep a list of devices.</p>
		}
		<ul class="rows">
			for _, d := range p.Devices {
				<li>
					<strong>{ d.Label }</strong>
					if d.Current {
						<span class="count">this device</span>
					}
					<span class="muted">signed in { d.Since }, last used { d.LastSeen }</span>
					<form method="post" action={ templ.SafeURL("/devices/" + d.ID + "/revoke") } hx-boost="false">
						<input type="hidden" name="csrf" value={ p.CSRF }/>
						if d.Current {
							<button class="quiet">Sign out</button>
						} else {
							<button class="danger">Sign out this device</button>
						}
					</form>
				</li>
			}
		</ul>
		<p class="muted">The API token for the host's CLI is not a device: change <code>api_token_file</code> to replace it. A passkey is revoked on the host with <code>whr passkey rm</code>.</p>
	}
}

templ cancelView(p cancelPage) {
	@layout(p.nav, "Cancel") {
		<h1>Cancel { p.Repo }{ p.Issue }?</h1>
		<p>This stops the agent and ends the task. It cannot be undone; the work the agent already did stays in its workspace.</p>
		<form method="post" action={ templ.SafeURL("/tasks/" + p.ID + "/cancel") } class="actions">
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="key" value={ p.Key }/>
			<button class="danger">Cancel the task</button>
			<a class="button" href={ templ.SafeURL("/tasks/" + p.ID) }>Keep it running</a>
		</form>
	}
}

templ openView(p openPage) {
	@layout(p.nav, "Editor copy") {
		<h1>Editor copy of { p.Repo }{ p.Issue }</h1>
		<p>The supervisor made its own copy of the agent's branch. It is not the agent's checkout, has no hooks and none of the agent's configuration, and is refreshed without overwriting your edits.</p>
		<pre class="untrusted">{ p.Path }</pre>
		if len(p.Warnings) > 0 {
			<p class="flash">These files in the copy can run things when an editor opens the folder. Read them before you trust it:</p>
			<ul>
				for _, w := range p.Warnings {
					<li><code>{ w }</code></li>
				}
			</ul>
		}
		<p><a href={ templ.SafeURL("/tasks/" + p.ID) }>Back to the task</a></p>
	}
}
