package web

import "strconv"

// Every string below is text, escaped by templ. No template uses templ.Raw or an
// unsafe attribute: text from an issue, an agent or the forge never becomes HTML.

templ layout(n nav, title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true}'/>
			<title>{ title } · workharbor</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
			<script src="/static/sse.js" defer></script>
		</head>
		<body hx-boost="true">
			<header class="bar">
				<a class="brand" href="/">workharbor</a>
				if n.CSRF != "" {
					<nav>
						<a href="/" class={ tab(n.Active, "harbor") }>Harbor</a>
						<a href="/inbox" class={ tab(n.Active, "inbox") }>
							Inbox
							if n.Inbox > 0 {
								<span class="count">{ strconv.Itoa(n.Inbox) }</span>
							}
						</a>
					</nav>
					<form method="post" action="/logout" hx-boost="false">
						<input type="hidden" name="csrf" value={ n.CSRF }/>
						<button class="quiet">Sign out</button>
					</form>
				}
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

func tab(active, name string) string {
	if active == name {
		return "tab current"
	}
	return "tab"
}

templ flashNote(msg string) {
	if msg != "" {
		<p class="flash" role="status">{ msg }</p>
	}
}

templ loginView(msg string) {
	@layout(nav{}, "Sign in") {
		<h1>Sign in</h1>
		if msg != "" {
			<p class="flash bad" role="alert">{ msg }</p>
		}
		<form method="post" action="/login" hx-boost="false" class="stack">
			<label for="token">API token</label>
			<input id="token" name="token" type="password" autocomplete="current-password" required/>
			<button class="primary">Sign in</button>
		</form>
		<p class="muted">The token is the one in your `whr` configuration (<code>api_token_file</code>).</p>
	}
}

templ errorPage(csrf string, status int, msg string) {
	@layout(nav{CSRF: csrf}, "Error") {
		<h1>{ strconv.Itoa(status) }</h1>
		<p class="flash bad" role="alert">{ msg }</p>
		<p><a href="/">Back to the harbor</a></p>
	}
}

templ taskList(rows []taskRow) {
	<ul class="cards">
		for _, t := range rows {
			<li class="card">
				<a href={ templ.SafeURL("/tasks/" + t.ID) }>
					<strong>{ t.Repo }{ t.Issue }</strong>
					<span class={ "state " + t.State }>{ t.State }</span>
				</a>
				if t.Agent != "" {
					<span class="muted">{ t.Agent }</span>
				}
			</li>
		}
	</ul>
}

templ harborView(p harborPage) {
	@layout(p.nav, "Harbor") {
		<h1>Harbor</h1>
		@flashNote(p.Flash)
		<section aria-labelledby="needs">
			<h2 id="needs">Needs you</h2>
			if len(p.NeedsYou) == 0 {
				<p class="muted">Nothing is waiting for you.</p>
			} else {
				@taskList(p.NeedsYou)
			}
		</section>
		<section aria-labelledby="start">
			<h2 id="start">Start a task</h2>
			if len(p.Agents) == 0 {
				<p class="muted">No agent exists yet: create one with <code>whr ws add</code>.</p>
			} else {
				<form method="post" action="/tasks" class="stack">
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					<input type="hidden" name="key" value={ p.Key }/>
					<label for="issue">Issue address</label>
					<input id="issue" name="issue" type="url" inputmode="url" placeholder="https://github.com/owner/repo/issues/12" required/>
					<label for="agent">Agent</label>
					<select id="agent" name="agent" required>
						for _, a := range p.Agents {
							<option value={ a.Ref }>{ a.Ref } ({ a.Repo })</option>
						}
					</select>
					<button class="primary">Start</button>
				</form>
			}
		</section>
		<section aria-labelledby="others">
			<h2 id="others">Tasks</h2>
			if len(p.Others) == 0 {
				<p class="muted">No other tasks.</p>
			} else {
				@taskList(p.Others)
			}
		</section>
	}
}

templ decisionCard(d decisionRow, csrf string) {
	<article class="decision">
		<h3>{ d.Kind }</h3>
		<p class="subject">{ d.Subject }</p>
		if d.Input != "" {
			<pre class="untrusted">{ d.Input }</pre>
		}
		if d.Deadline != "" {
			<p class="muted">Answer by { d.Deadline } or it is denied.</p>
		}
		<p class="muted"><a href={ templ.SafeURL("/tasks/" + d.TaskID) }>Open the task</a></p>
		if d.Review {
			<p class="flash">This answer publishes code, so it needs your passkey, which this page cannot ask yet. Answer it with <code>whr approve</code> or <code>whr reject</code> on the host.</p>
		} else {
			<form method="post" action={ templ.SafeURL("/decisions/" + d.ID + "/answer") } class="stack">
				<input type="hidden" name="csrf" value={ csrf }/>
				<input type="hidden" name="key" value={ d.Key }/>
				<label for={ "reason-" + d.ID }>Reason (optional, the agent sees it)</label>
				<input id={ "reason-" + d.ID } name="reason" type="text" maxlength="500"/>
				<div class="actions">
					for _, o := range d.Options {
						<button name="option" value={ o } class={ optionClass(o) }>{ o }</button>
					}
				</div>
			</form>
		}
	</article>
}

func optionClass(o string) string {
	switch o {
	case "allow", "start", "resume":
		return "primary"
	case "deny", "cancel":
		return "danger"
	}
	return ""
}

templ inboxView(p inboxPage) {
	@layout(p.nav, "Inbox") {
		<h1>Inbox</h1>
		@flashNote(p.Flash)
		if len(p.Decisions) == 0 {
			<p class="muted">Nothing needs an answer.</p>
		}
		for _, d := range p.Decisions {
			@decisionCard(d, p.CSRF)
		}
	}
}

templ eventItem(e eventRow) {
	<li class={ "ev " + e.Label } id={ evID(e) }>
		<span class="at">{ e.At }</span>
		<span class="label">{ e.Label }</span>
		if e.Text != "" {
			<span class="text">{ e.Text }</span>
		}
		if e.Detail != "" {
			<pre class="untrusted">{ e.Detail }</pre>
		}
	</li>
}

func evID(e eventRow) string {
	if e.Seq == 0 {
		return ""
	}
	return "ev-" + itoa(e.Seq)
}

templ taskView(p taskPage) {
	@layout(p.nav, p.Repo+p.Issue) {
		<h1>{ p.Repo }{ p.Issue }</h1>
		@flashNote(p.Flash)
		<p>
			<span class={ "state " + p.State }>{ p.State }</span>
			if p.Agent != "" {
				<span class="muted">{ p.Agent }</span>
			}
			if p.Branch != "" {
				<span class="muted">{ p.Branch }</span>
			}
			if p.PRURL != "" {
				<a href={ templ.SafeURL(p.PRURL) } rel="noreferrer">pull request</a>
			}
		</p>
		if len(p.Decisions) > 0 {
			<section aria-labelledby="open">
				<h2 id="open">Waiting for you</h2>
				for _, d := range p.Decisions {
					@decisionCard(d, p.CSRF)
				}
			</section>
		}
		<section aria-labelledby="transcript-h">
			<h2 id="transcript-h">Transcript</h2>
			if p.Earlier > 0 {
				<p class="muted">{ strconv.Itoa(p.Earlier) } earlier events are not shown: <code>whr logs</code> has them.</p>
			}
			<ol id="transcript" class="transcript" data-live="true" hx-ext="sse" sse-connect={ p.sinceURL() } sse-swap="ev" hx-swap="beforeend">
				for _, e := range p.Events {
					@eventItem(e)
				}
			</ol>
			<noscript><p class="muted">This is the transcript as of loading the page; reload it to see more.</p></noscript>
		</section>
		<section aria-labelledby="say">
			<h2 id="say">Send a message</h2>
			<form method="post" action={ templ.SafeURL("/tasks/" + p.ID + "/say") } class="stack">
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				<input type="hidden" name="key" value={ p.SayKey }/>
				<label for="message">To the agent</label>
				<textarea id="message" name="message" rows="3" maxlength="20000" required></textarea>
				<button class="primary">Send</button>
			</form>
		</section>
		if p.Agent != "" {
			<form method="post" action={ templ.SafeURL("/tasks/" + p.ID + "/open") } class="actions">
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				<button>Make an editor copy</button>
			</form>
		}
		if p.Cancelable {
			<p><a class="button danger" href={ templ.SafeURL("/tasks/" + p.ID + "/cancel") }>Cancel this task…</a></p>
		}
	}
}

templ cancelView(p cancelPage) {
	@layout(p.nav, "Cancel") {
		<h1>Cancel { p.Repo }{ p.Issue }?</h1>
		<p>This stops the agent and ends the task. It cannot be undone; the work the agent already did stays in its workspace.</p>
		<form method="post" action={ templ.SafeURL("/tasks/" + p.ID + "/cancel") } class="actions">
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="key" value={ p.Key }/>
			<button class="danger">Cancel the task</button>
			<a class="button" href={ templ.SafeURL("/tasks/" + p.ID) }>Keep it running</a>
		</form>
	}
}

templ openView(p openPage) {
	@layout(p.nav, "Editor copy") {
		<h1>Editor copy of { p.Repo }{ p.Issue }</h1>
		<p>The supervisor made its own copy of the agent's branch. It is not the agent's checkout, has no hooks and none of the agent's configuration, and is refreshed without overwriting your edits.</p>
		<pre class="untrusted">{ p.Path }</pre>
		if len(p.Warnings) > 0 {
			<p class="flash">These files in the copy can run things when an editor opens the folder. Read them before you trust it:</p>
			<ul>
				for _, w := range p.Warnings {
					<li><code>{ w }</code></li>
				}
			</ul>
		}
		<p><a href={ templ.SafeURL("/tasks/" + p.ID) }>Back to the task</a></p>
	}
}
