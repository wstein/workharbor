# The workharbor console on Fedora (design D43): the stock image pinned by digest, the tools
# for the human's shell work, and the git wrapper that runs git safely in a workspace
# whose .git an agent wrote. No Docker CLI and no container engine, no credentials.
# The digest is the one of the base image (internal/baseimage); changing either file
# changes the image's tag, so the next start builds it again.
FROM docker.io/library/fedora@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80
RUN dnf -y --setopt=install_weak_deps=False install \
        git-core zsh fish jq curl ripgrep tmux vim-minimal make less util-linux util-linux-script procps-ng findutils ca-certificates openssh-server openssh-clients \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf* \
    && useradd -u 1000 -m -s /bin/zsh workharbor
COPY whr-git /usr/local/bin/git
RUN chmod 0755 /usr/local/bin/git
# The console's sshd (issue #32): started by the supervisor as the console user, with
# the certificate authority's public key in WHR_SSH_CA. The configuration is in the
# image; a login shell reads the proxy variables whr-sshd leaves in /tmp/whr-proxy-vars.
COPY whr-sshd /usr/local/bin/whr-sshd
COPY sshd_config /etc/whr/sshd_config
RUN chmod 0755 /usr/local/bin/whr-sshd \
    && chmod 0644 /etc/whr/sshd_config \
    && printf '%s\n' '[ -r /tmp/whr-proxy-vars ] && . /tmp/whr-proxy-vars' > /etc/profile.d/whr-env.sh \
    && mkdir -p /etc \
    && printf '%s\n' '[ -r /tmp/whr-proxy-vars ] && . /tmp/whr-proxy-vars' >> /etc/zshenv
