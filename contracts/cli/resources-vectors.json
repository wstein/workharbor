  ],
  "offline": true
 },
 "classification_order": [
  "empty: the empty string",
  "sign: first character '+' or '-' (so '-0', '+inf' and '-inf' are sign)",
  "nonfinite: starts with nan, inf or infinity, any case",
  "exponent: digits and dots followed by e or E (so '1e3GiB' is exponent)",
  "syntax: not matching the grammar, including leading zeros ('007', '007GiB'), a trailing or leading dot, whitespace, non-ASCII digits and zero-width characters",
  "missing_unit (memory): a valid integer with no unit",
  "bad_unit (memory): a valid integer followed by letters that are not exactly MiB or GiB",
  "excess_precision (cpu): more than three fractional digits, even when they are zeros",
  "not_positive: canonical value zero",
  "overflow: canonical value above 2^63-1"
 ]
}
