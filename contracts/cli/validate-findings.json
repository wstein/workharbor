  "unborn_head": "HEAD is unborn exactly when git rev-parse --verify --quiet HEAD exits 1 with empty stderr and .git/HEAD is a symbolic reference to a missing ref; every other non-zero exit, timeout or unparsable output is git.listing_failed. cat-file of .gitmodules runs only when the index (unborn HEAD) or the HEAD tree lists it.",
  "manifest_vectors": "contracts/workspace/vectors.json"
}
