{
  "schema_version": 1,
  "contract": "whr-commands",
  "decision": "H77",
  "adr": "docs/adr/0014-whr-command-structure.md",
  "status": "proposed",
  "group_aliases": {
    "workspace": [
      "ws"
    ]
  },
  "rules": [
    "Short forms are aliases of the same command; the canonical id is used in --json, logs and errors.",
    "Short forms exist only for the verbs listed by decision H77 (an allowlist). As a constraint on it, a verb that exists in more than one group gets a short form only for workspace; host setup, doctor, offboard and service, and auth login and logout, have short forms because their verbs exist in no other group.",
    "A short form must be unique, must not equal a group name other than service, and must not shadow a canonical top-level command.",
    "A new short form requires a change to this table, its freeze test and an owner-reviewed spec amendment."
  ],
  "needs_values": {
    "none": "no network, credentials or control plane",
    "control_plane": "owner API over TLS",
    "host_local": "local host privileges and tools"
  },
  "blocked_on_values": {
    "owner_api": "the control plane owner API for workspaces, operations, hosts and agents does not exist yet (only /api/v1/hosts and /api/v1/auth)",
    "host_setup_wi": "host setup and service work item T015 (no agent service unit or typed change plan exists)",
    "owner_client": "the typed TLS owner client and credential storage work item (T011); the router already serves /api/v1/auth/login|status|logout and /api/v1/hosts/:id"
  },
  "commands": [
    {"id": "workspace.promote", "path": ["workspace", "promote"], "short": null, "increment": "first", "needs": "none", "writes": "local", "json": "envelope", "flags": ["--local", "--dry-run", "--yes", "--json"]},
    {"id": "workspace.stage", "path": ["workspace", "stage"], "short": null, "increment": "first", "needs": "none", "writes": "local", "json": "envelope", "flags": ["--local", "--source", "--smoke", "--dry-run", "--trust", "--yes", "--json"]},
    {"id":"workspace.drift","path":["workspace","drift"],"increment":"first","needs":"none","writes":"none","json":"envelope","flags":["--local","--source","--json"]},
    {"id": "workspace.home.clone", "path": ["workspace", "home", "clone"], "short": null, "increment": "first", "needs": "none", "writes": "local", "json": "envelope", "flags": ["--local", "--to", "--exclude", "--include-credentials", "--dry-run", "--trust", "--yes", "--json"], "note": "home clone/backup amendment 2026-10-29: copy a workspace home into a new volume with tar in the digest-pinned helper_images.base image; ./.cache and credentials excluded"},
    {"id": "workspace.home.backup", "path": ["workspace", "home", "backup"], "short": null, "increment": "first", "needs": "none", "writes": "local", "json": "envelope", "flags": ["--local", "--to", "--dry-run", "--trust", "--yes", "--json"], "note": "home clone/backup amendment 2026-10-29: same engine, only ./.cache excluded"},
    {"id": "workspace.recover", "path": ["workspace", "recover"], "short": null, "increment": "first", "needs": "none", "writes": "local", "json": "rejected", "flags": ["--local", "--toolbox", "--rw", "--net", "--dry-run"], "note": "recover amendment 2026-10-29: throwaway container with the workspace home (read-only by default) and a BundleDock toolbox mounted; terminal only"},
    {"id": "workspace.ls", "path": ["workspace", "ls"], "short": ["ls"], "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_api", "flags": ["--local", "--role", "--label", "--json"], "note": "FR-066 local-only discovery is implemented; without --local owner_api still refuses with exit 64"},
    {"id": "workspace.show", "path": ["workspace", "show"], "short": ["show"], "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "workspace.create", "path": ["workspace", "create"], "short": ["create"], "increment": "later", "needs": "control_plane", "writes": "remote", "json": "envelope", "blocked_on": "owner_api", "flags": ["--cpus", "--memory"], "first_increment_part": "none: wave 1a ships only the pure resource parsing library and contracts/cli/resources-vectors.json (FR-059); no flags, prompts or wiring until wave 2"},
    {"id": "workspace.start", "path": ["workspace", "start"], "short": ["start"], "increment": "later", "needs": "control_plane", "writes": "remote", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "workspace.stop", "path": ["workspace", "stop"], "short": ["stop"], "increment": "later", "needs": "control_plane", "writes": "remote", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "workspace.rebuild", "path": ["workspace", "rebuild"], "short": ["rebuild"], "increment": "later", "needs": "control_plane", "writes": "remote", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "workspace.rm", "path": ["workspace", "rm"], "short": ["rm"], "increment": "later", "needs": "control_plane", "writes": "remote", "json": "envelope", "blocked_on": "owner_api", "flags": ["--local", "--role", "--label", "--volumes", "--force", "--dry-run", "--yes", "--json"], "note": "FR-067 local-only removal; without --local owner_api still refuses with exit 64"},
    {"id": "workspace.shell", "path": ["workspace", "shell"], "short": ["shell"], "increment": "later", "needs": "control_plane", "writes": "none", "json": "events", "blocked_on": "owner_api", "flags": ["--local"], "note": "Feature 010: local terminal-only login shell; --json rejected locally, remote events contract and owner_api refusal retained"},
    {"id": "workspace.console", "path": ["workspace", "console"], "short": ["console"], "increment": "later", "needs": "control_plane", "writes": "none", "json": "events", "blocked_on": "owner_api", "flags": ["--local"], "note": "Feature 010: --local always refuses 64 with shell/host-session guidance; remote console remains deferred"},
    {"id": "workspace.ssh", "path": ["workspace", "ssh"], "short": ["ssh"], "increment": "later", "needs": "control_plane", "writes": "none", "json": "rejected", "blocked_on": "owner_api"},
    {"id": "workspace.open", "path": ["workspace", "open"], "short": ["open"], "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "workspace.init", "path": ["workspace", "init"], "short": ["init"], "increment": "first", "needs": "none", "writes": "local", "json": "envelope", "note": "local configuration authoring (FR-043..FR-050, FR-056..FR-058, FR-064); runtime parts of FR-047/FR-048 are not in this release; the only writing command of the first increment", "flags": ["--name", "--project-url", "--start-dir", "--devcontainer", "--template", "--human-shell", "--console-mode", "--shortcuts", "--non-interactive", "--yes", "--dry-run", "--overwrite", "--no-agents-block", "--helper-base-image", "--json"], "availability": {"wave_1a": "non-interactive core D1: --name, --project-url, --start-dir, --human-shell, --console-mode, --shortcuts, --non-interactive, --yes, --dry-run, --overwrite, --json (the agent workflow block of FR-064 and --no-agents-block arrive with T036 in wave 1b); requires a directory that already contains the devcontainer file (owner-decided narrowing: starters are unsupported); --non-interactive without --yes and without --dry-run exits 70 naming --yes; --devcontainer exits 64 'not in this release'; without --non-interactive and without --dry-run it exits 64 'not in this release' (the wizard is wave 1b)", "wave_1b": "interactive wizard D2 (back, review, cancel), --devcontainer selection D3 and the agent workflow block in AGENTS.md with --no-agents-block (FR-064, T036, on by default, after D1)", "wave_2": "--template (starters unsupported until provider admission)"}},
    {"id": "workspace.validate", "path": ["workspace", "validate"], "short": ["validate"], "increment": "first", "needs": "none", "writes": "none", "json": "envelope"},
    {"id": "host.setup", "path": ["host", "setup"], "short": ["setup"], "increment": "later", "needs": "host_local", "writes": "host", "json": "envelope", "blocked_on": "host_setup_wi", "note": "setup --dry-run is deferred with it"},
    {"id": "host.doctor", "path": ["host", "doctor"], "short": ["doctor"], "increment": "first", "needs": "none", "writes": "none", "json": "envelope", "note": "first-increment checks need no privileges; control-plane checks report skipped (doctor-checks.json)"},
    {"id": "host.offboard", "path": ["host", "offboard"], "short": ["offboard"], "increment": "later", "needs": "host_local", "writes": "host", "json": "envelope", "blocked_on": "host_setup_wi"},
    {"id": "host.service.install", "path": ["host", "service", "install"], "short": ["service", "install"], "increment": "later", "needs": "host_local", "writes": "host", "json": "envelope", "blocked_on": "host_setup_wi"},
    {"id": "host.service.uninstall", "path": ["host", "service", "uninstall"], "short": ["service", "uninstall"], "increment": "later", "needs": "host_local", "writes": "host", "json": "envelope", "blocked_on": "host_setup_wi"},
    {"id": "host.service.status", "path": ["host", "service", "status"], "short": ["service", "status"], "increment": "later", "needs": "host_local", "writes": "none", "json": "envelope", "blocked_on": "host_setup_wi"},
    {"id": "host.ls", "path": ["host", "ls"], "short": null, "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_api", "note": "no short form: ls belongs to workspace"},
    {"id": "host.show", "path": ["host", "show"], "short": null, "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_client", "note": "no short form: show belongs to workspace"},
    {"id": "auth.login", "path": ["auth", "login"], "short": ["login"], "increment": "later", "needs": "control_plane", "writes": "local", "json": "envelope", "blocked_on": "owner_client"},
    {"id": "auth.status", "path": ["auth", "status"], "short": null, "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_client", "note": "no short form: bare status is ambiguous with workspace and console status"},
    {"id": "auth.logout", "path": ["auth", "logout"], "short": ["logout"], "increment": "later", "needs": "control_plane", "writes": "local", "json": "envelope", "blocked_on": "owner_client"},
    {"id": "op.show", "path": ["op", "show"], "short": null, "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "op.wait", "path": ["op", "wait"], "short": null, "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "agent.ls", "path": ["agent", "ls"], "short": null, "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "agent.attach", "path": ["agent", "attach"], "short": null, "increment": "later", "needs": "control_plane", "writes": "none", "json": "events", "blocked_on": "owner_api"},
    {"id": "agent.status", "path": ["agent", "status"], "short": null, "increment": "later", "needs": "control_plane", "writes": "none", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "agent.send", "path": ["agent", "send"], "short": null, "increment": "later", "needs": "control_plane", "writes": "remote", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "agent.stop", "path": ["agent", "stop"], "short": null, "increment": "later", "needs": "control_plane", "writes": "remote", "json": "envelope", "blocked_on": "owner_api"},
    {"id": "version", "path": ["version"], "short": null, "increment": "first", "needs": "none", "writes": "none", "json": "envelope"},
    {"id": "completion", "path": ["completion"], "short": null, "increment": "first", "needs": "none", "writes": "none", "json": "rejected", "note": "prints a shell completion script for bash, zsh or fish"},
    {"id": "help", "path": ["help"], "short": null, "increment": "first", "needs": "none", "writes": "none", "json": "rejected", "note": "equivalent to --help"}
  ],
  "freeze": {
    "test_file": "apps/whr/internal/commands/table_test.go",
    "test_ids": [
      "TestLocalHomeCopyCommandContract",
      "TestLocalStageCommandContractAndAlias",
      "TestLocalShellContractAmendment",
      "TestLocalLsContractAmendment",
      "TestCommandTableMatchesContract",
      "TestCommandTableAliasRules",
      "TestAliasInvocationEquivalent",
      "TestJSONCommandFieldIsCanonical",
      "TestHelpShowsShortFormHint",
      "TestCompletionKnowsBothForms",
      "TestLaterCommandsRefuseWithoutBackend",
      "TestInitFlagsMatchContract"
    ],
    "offline": true
  }
}
