{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workharbor.invalid/contracts/cli/output.schema.json",
  "title": "whr --json envelope, schema_version 1 (first-increment subset)",
  "description": "Planned by ADR 0010 and FR-015. This revision defines the envelope and the results of the first-increment commands (version, workspace.validate, workspace.init, host.doctor). Results of later commands and the typed event stream of shell, console and agent attach are added by their own work items and never change an existing definition without a new schema_version. The command field is always the canonical id from commands.json, whichever alias was typed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "ok",
    "exit_code"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z]+)*$",
      "description": "Canonical id from commands.json; the string \"unknown\" when the typed command did not resolve (usage error)."
    },
    "ok": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer",
      "enum": [
        0,
        64,
        65,
        66,
        67,
        68,
        69,
        70,
        71,
        72,
        73,
        74
      ],
      "description": "Equals the process exit status; contracts/cli/exit-codes.json is authoritative."
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "usage",
            "not_found",
            "unauthenticated",
            "forbidden",
            "conflict",
            "incompatible_contract",
            "needs_human",
            "timeout",
            "interrupted",
            "partial_failure",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "remediation": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "operation_id": {
      "type": "string",
      "description": "Only for commands that create or find a control-plane operation; absent for local commands."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "not": {
          "required": [
            "error"
          ]
        },
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "exit_code": {
            "minimum": 64
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "version"
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/versionResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "workspace.validate"
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/validateResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "workspace.init"
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/initResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "host.doctor"
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/doctorResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          },
          "command": {
            "enum": [
              "workspace.validate",
              "host.doctor"
            ]
          },
          "exit_code": {
            "const": 68
          }
        },
        "required": [
          "ok",
          "command",
          "exit_code"
        ]
      },
      "then": {
        "required": [
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          },
          "command": {
            "const": "workspace.init"
          },
          "exit_code": {
            "const": 73
          }
        },
        "required": [
          "ok",
          "command",
          "exit_code"
        ]
      },
      "then": {
        "required": [
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          },
          "command": {
            "const": "workspace.init"
          },
          "exit_code": {
            "const": 68
          }
        },
        "required": [
          "ok",
          "command",
          "exit_code"
        ]
      },
      "then": {
        "required": [
          "result"
        ],
        "description": "validation carries the pre-write validate result of existing content when findings caused the conflict"
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 64
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "usage"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 65
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "not_found"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 66
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "unauthenticated"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 67
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "forbidden"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 68
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "conflict"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 69
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "incompatible_contract"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 70
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "needs_human"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 71
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "timeout"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 72
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "interrupted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 73
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "partial_failure"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 74
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "exit_code",
          "ok"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "internal"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024,
          "description": "Path relative to the validated directory, or null. Untrusted text; JSON-escaped."
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "remediation": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skipped",
            "unknown"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "remediation": {
          "type": "string",
          "maxLength": 1024
        },
        "reason": {
          "enum": [
            "requires_control_plane",
            "not_in_increment",
            "precondition_absent",
            "not_measurable",
            "unsupported_platform",
            "remote_not_checked"
          ],
          "description": "Required when status is skipped or unknown."
        },
        "evidence": {
          "type": "object",
          "description": "Measured values only; redacted (no home directory, user name, host name, environment values or credentials)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "skipped",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "fail"
              }
            }
          },
          "then": {
            "required": [
              "remediation"
            ]
          }
        }
      ]
    },
    "counts4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "skipped",
        "unknown"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "validateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "valid",
        "provider_admission",
        "counts",
        "findings",
        "truncated"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "description": "As supplied; untrusted text."
        },
        "valid": {
          "type": "boolean",
          "description": "True when no finding has severity error. Warnings do not invalidate."
        },
        "provider_admission": {
          "const": "not_evaluated",
          "description": "Validation never claims the configuration is provisionable; the host agent decides at trust time."
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error",
            "warning",
            "info"
          ],
          "properties": {
            "error": {
              "type": "integer",
              "minimum": 0
            },
            "warning": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "truncated": {
          "type": "boolean",
          "description": "True when more than 200 findings were produced; counts stay exact."
        }
      }
    },
    "initResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "dry_run",
        "actions",
        "validation",
        "runtime_enforcement",
        "git_checks",
        "bundle_selection_unavailable"
      ],
      "properties": {
        "directory": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "kind",
              "path"
            ],
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "overwrite",
                  "reuse",
                  "skip_existing"
                ]
              },
              "kind": {
                "enum": [
                  "directory",
                  "file"
                ]
              },
              "path": {
                "type": "string"
              },
              "applied": {
                "type": "boolean",
                "description": "False for every action of a dry run."
              },
              "diff": {
                "type": "string",
                "maxLength": 65536,
                "description": "Proposed contents or diff; untrusted text, JSON-escaped. Truncated to 65536 characters per file with diff_truncated true; the written content is never truncated."
              },
              "diff_truncated": {
                "type": "boolean"
              }
            }
          }
        },
        "validation": {
          "$ref": "#/$defs/validateResult",
          "description": "Result of validating the proposal (dry run, in memory) or the written output with the Git-free profile of validate; Git-derived checks are not run."
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths this run created and still holds (empty for a dry run)."
        },
        "remaining": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths a failed rollback could not remove; non-empty only with exit code 73."
        },
        "runtime_enforcement": {
          "const": "not_in_this_release"
        },
        "git_checks": {
          "const": "not_run"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "origin"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "flag",
                    "existing",
                    "default"
                  ]
                }
              }
            },
            "start_dir": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "origin"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "flag",
                    "existing",
                    "default"
                  ]
                }
              }
            },
            "human_shell": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "origin"
              ],
              "properties": {
                "value": {
                  "enum": [
                    "fish",
                    "bash",
                    "zsh",
                    "nu"
                  ]
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "flag",
                    "existing",
                    "default"
                  ]
                }
              }
            },
            "console_mode": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "origin"
              ],
              "properties": {
                "value": {
                  "enum": [
                    "herdr",
                    "plain"
                  ]
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "flag",
                    "existing",
                    "default"
                  ]
                }
              }
            },
            "shortcuts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "origin"
              ],
              "properties": {
                "value": {
                  "enum": [
                    "on",
                    "off"
                  ]
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "flag",
                    "existing",
                    "default"
                  ]
                }
              }
            },
            "project": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "origin"
              ],
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "path"
                  ],
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  }
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "flag",
                    "existing",
                    "default"
                  ]
                }
              }
            }
          },
          "description": "Effective manifest settings with the origin of each value (flag, existing, default)."
        },
        "settings_not_persisted": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "start_dir",
              "human_shell",
              "console_mode",
              "shortcuts"
            ]
          },
          "description": "Settings of a defaults-only run that could not be written because an existing version 1 manifest was preserved (explicit flags needing the edit exit 70 instead)."
        },
        "bundle_selection_unavailable": {
          "const": true,
          "description": "FR-050: bundle selection is not offered; new manifests carry an empty list and existing declarations are left unchanged."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dry_run": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "actions": {
                "items": {
                  "properties": {
                    "applied": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "doctorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "verdict",
        "counts",
        "checks"
      ],
      "properties": {
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "arch"
          ],
          "properties": {
            "os": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            }
          }
        },
        "verdict": {
          "enum": [
            "ok",
            "failed",
            "incomplete"
          ],
          "description": "failed: at least one fail. incomplete: no fail but at least one skipped or unknown. ok: every check passed."
        },
        "counts": {
          "$ref": "#/$defs/counts4"
        },
        "checks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "versionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "build_date",
        "client_platform",
        "contract_versions"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "build_date": {
          "type": "string"
        },
        "client_platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "arch"
          ],
          "properties": {
            "os": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            }
          }
        },
        "contract_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
